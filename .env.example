PORT=4000

# PostgreSQL connection string. From Neon: Dashboard -> Connect -> copy the string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Firebase project id (Project settings -> General -> Project ID)
FIREBASE_PROJECT_ID=your-firebase-project-id

# Service account (Project settings -> Service accounts -> Generate new private key).
# Copy client_email and private_key from the downloaded JSON. Keep the quotes and the \n.
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nPASTE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Local development without a real Firebase project: run `npm run emulator`
# in another terminal and uncomment this line (FIREBASE_PROJECT_ID must start with demo-).
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Tests use their own database and always run on the Firestore emulator.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chat_test
